# Box OAuth2 Configuration
# Get these from your Box Developer Console: https://app.box.com/developers/console

# Required: Box Application Credentials
Box_Client_Id=your_box_client_id_here
Box_Client_Secret=your_box_client_secret_here

# Optional: Environment Settings
BOX_REDIRECT_URI=http://localhost:8080
BOX_TOKEN_FILE=box_oauth_tokens.json

# Database Configuration (for future use)
NEO4J_PASSWORD=your_neo4j_password

# Azure Configuration (for future use)
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id  
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_STORAGE_ACCOUNT=your_storage_account

# Confluence Configuration (for future use)
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your_email@domain.com
CONFLUENCE_API_TOKEN=your_confluence_api_token
